#!/usr/bin/env bash
# Pre-commit hook for horae
# Checks code formatting, clippy lints, and test suite before committing.

set -euo pipefail

echo "==> Running pre-commit checks for horae..."

# 1. Format check
echo "[1/3] Checking rustfmt..."
cargo fmt --check || {
    echo "❌ Formatting issues found. Run 'cargo fmt' to fix them." >&2
    exit 1
}

# 2. Clippy check
echo "[2/3] Checking clippy (deny warnings)..."
cargo clippy --all-targets -- -D warnings || {
    echo "❌ Clippy warnings found. Clippy must stay clean with -- -D warnings." >&2
    exit 1
}

# 3. Test check
echo "[3/3] Running tests..."
cargo test --all-targets || {
    echo "❌ Tests failed. All tests must pass before committing." >&2
    exit 1
}

echo "✅ All pre-commit checks passed!"
